# Environment Variables for AI Work OS

PROJECT_NAME="AI Work OS"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="ai_work_os_super_secret_jwt_key_2026_change_in_prod"

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_work_os"
USE_SQLITE_FALLBACK="true"
SQLITE_URL="sqlite+aiosqlite:///./ai_work_os.db"

# Local AI Engine & Vector Search
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5"
EMBEDDING_MODEL="nomic-embed-text"
MOCK_LLM_FALLBACK="true"

# Next.js Frontend
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
